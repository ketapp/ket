#!/bin/sh
# Turned on with `git config core.hooksPath .githooks`; see CONTRIBUTING.md.

# A merge commit carries commits that were each checked on their way in.
git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0

subject=$(grep -v '^#' "$1" | grep -m1 -v '^[[:space:]]*$')
"$(git rev-parse --show-toplevel)/scripts/check-commit-msg.sh" "$subject" || exit 1

# A checkout may ask more of the message than the format: a
# `commit-msg.local` beside git's own hooks runs here when it is executable,
# and is never part of the repository.
local=$(git rev-parse --git-common-dir)/hooks/commit-msg.local
if [ -x "$local" ]; then
	exec "$local" "$@"
fi
exit 0

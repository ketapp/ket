<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ket Helper (GPU).app compiles shaders to machine code when it falls back to
  SwiftShader, Chromium's software renderer (libvk_swiftshader.dylib in the
  framework). Chromium's own chrome/app/helper-gpu-entitlements.plist,
  unchanged.

  Only the hardened runtime enforces entitlements: a Developer ID build, or
  an ad-hoc one with KET_HARDENED_RUNTIME=1 (scripts/bundle-macos.sh). CEF
  156 starts every child process from the plain helper at present, so this
  variant is signed but not run; see helper.plist.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>

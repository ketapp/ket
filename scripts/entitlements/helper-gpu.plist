<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ket Helper (GPU).app compiles shaders to machine code when it falls back to
  SwiftShader, Chromium's software renderer (libvk_swiftshader.dylib in the
  framework). Chromium's own chrome/app/helper-gpu-entitlements.plist,
  unchanged.

  Only the hardened runtime enforces entitlements, and ket is signed ad hoc
  without it until a Developer ID signature is possible (it waits on the
  LLC's Apple Developer account). Recorded now so that signature starts from
  the right set. See scripts/chromium-dev.sh.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>

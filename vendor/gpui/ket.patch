+/// ket patch: frames in a row with nothing to draw before a window stops
+/// requesting them — about 66ms on a 120Hz display. Short, because every
+/// requested frame wakes two threads; not zero, because pausing and resuming
+/// the display link is not free either and a burst of activity comes in waves.
+const IDLE_FRAMES_BEFORE_PAUSE: u32 = 8;
+
+/// ket patch: whether input is arriving fast enough to keep presenting.
+///
+/// gpui presented the unchanged frame on every refresh for a second after
+/// *any* input, so the display would not lower its refresh rate under a drag
+/// or a scroll. For typing that was a second of full-rate presents per
+/// keystroke. Zed's current gpui keeps the idea but only for input arriving at
+/// around display rate, which this follows: [`FAST_INPUTS`] events inside
+/// [`INPUT_RATE_WINDOW`] sustain presenting for [`INPUT_SUSTAIN`].
+#[derive(Default)]
+pub(crate) struct InputRate {
+    recent: std::collections::VecDeque<Instant>,
+    sustain_until: Option<Instant>,
+}
+
+const INPUT_RATE_WINDOW: Duration = Duration::from_millis(100);
+const FAST_INPUTS: usize = 6;
+const INPUT_SUSTAIN: Duration = Duration::from_secs(1);
+
+impl InputRate {
+    fn record(&mut self, now: Instant) {
+        self.recent.push_back(now);
+        while self
+            .recent
+            .front()
+            .is_some_and(|first| now.duration_since(*first) > INPUT_RATE_WINDOW)
+        {
+            self.recent.pop_front();
+        }
+        if self.recent.len() >= FAST_INPUTS {
+            self.sustain_until = Some(now + INPUT_SUSTAIN);
+        }
+    }
+
+    fn sustaining(&self, now: Instant) -> bool {
+        self.sustain_until.is_some_and(|until| now < until)
+    }
+}
